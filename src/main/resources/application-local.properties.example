# Copy this file as application-local.properties for local development.
# application-local.properties is ignored by Git: never commit real passwords or JWT keys.

# Must contain at least 32 characters.
smartforma.jwt.secret=replace-with-a-private-local-jwt-secret-of-at-least-32-characters

# Demo ADMIN account created once when absent.
smartforma.admin.email=admin@smartforma.local
smartforma.admin.password=choose-a-local-admin-password
